# 生产 AI 服务环境变量（600，仅服务器）
# 由部署脚本生成；不要提交到仓库
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=<在此填入>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

DASHSCOPE_API_KEY=<在此填入>
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIM=1024
RAG_RETRIEVAL_MODE=vector
RAG_RERANK_ENABLED=false
RAG_TOOL_MIN_SCORE=0.67

JAVA_API_BASE=http://127.0.0.1:18080
AI_INTERNAL_TOKEN=<在此填入>
CORS_ORIGINS=https://lxlssr.icu,https://www.lxlssr.icu
AI_SESSION_TTL_SECONDS=3600
AI_MAX_HISTORY_TURNS=8
LANGFUSE_ENABLED=false
