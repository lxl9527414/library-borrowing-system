# =====================================================================
# 环境变量模板 —— 复制为 .env 后填写，.env 已在 .gitignore 中，绝不会入库
#   cp .env.example .env
# 注意：任何真实密钥都不要提交到 git，也不要贴在聊天窗口里。
# =====================================================================

# ---------------------------------------------------------------------
# 1) 业务后端 Spring Boot（backend/）
# ---------------------------------------------------------------------
SERVER_PORT=18080
# 本机直连 MySQL 时使用 127.0.0.1；docker compose 内运行时改成 mysql
DB_URL=jdbc:mysql://127.0.0.1:3306/library_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root
# docker compose 内运行时改成 redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
TOKEN_TTL=604800
SQL_INIT_MODE=always

# ---------------------------------------------------------------------
# 2) AI 服务（ai-service/）
# ---------------------------------------------------------------------
# 模型提供方：mock（离线开发/CI，无需任何 Key） | deepseek | qwen | ollama
LLM_PROVIDER=mock

# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（DashScope 的 OpenAI 兼容端点）
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 通义向量模型（DeepSeek 没有 embedding 接口，向量化必须走通义或本地 bge-m3）
QWEN_EMBEDDING_MODEL=text-embedding-v3

# 本地 Ollama（离线兜底）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 降级链：主模型失败时依次尝试（逗号分隔，留空表示不降级）
LLM_FALLBACK_CHAIN=
# 单次请求超时与最大重试
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# ---------------------------------------------------------------------
# 3) 服务间调用
# ---------------------------------------------------------------------
# AI 服务调用 Java 业务层内部工具接口
JAVA_API_BASE=http://127.0.0.1:18080
# 内部接口共享密钥（Java 与 AI 服务必须一致；生产环境务必改掉默认值）
AI_INTERNAL_TOKEN=dev-internal-token
# 前端调用 AI 服务的来源（开发环境 Vite）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# 4) 会话与缓存
# ---------------------------------------------------------------------
AI_REDIS_URL=redis://127.0.0.1:6379/1
AI_SESSION_TTL_SECONDS=3600
AI_MAX_HISTORY_TURNS=8

# ---------------------------------------------------------------------
# 5) 向量库（W3 RAG 阶段使用，W1 先留占位）
# ---------------------------------------------------------------------
PGVECTOR_DSN=postgresql://library:library@127.0.0.1:5433/library_ai
PGVECTOR_TABLE=library_knowledge

# ---------------------------------------------------------------------
# 6) 可观测（W4 启用）
# ---------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000
